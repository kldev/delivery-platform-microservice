{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Error"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "delivery-route": {
        "ClusterId": "delivery-cluster",
        "Match": {
          "Path": "/api/delivery/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/delivery"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "settlement-route": {
        "ClusterId": "settlement-cluster",
        "Match": {
          "Path": "/api/settlement/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/settlement"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": {
          "Path": "/api/payment/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/payment"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "ledger-route": {
        "ClusterId": "ledger-cluster",
        "Match": {
          "Path": "/api/ledger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/ledger"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      },
      "reconciliation-route": {
        "ClusterId": "ledger-cluster",
        "Match": {
          "Path": "/api/reconciliation/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/reconciliation"
          },
          {
            "PathPrefix": "/api"
          }
        ]
      }
    },
    "Clusters": {
      "delivery-cluster": {
        "Destinations": {
          "delivery": {
            "Address": "http://delivery:8080"
          }
        }
      },
      "settlement-cluster": {
        "Destinations": {
          "settlement": {
            "Address": "http://settlement:8080"
          }
        }
      },
      "ledger-cluster": {
        "Destinations": {
          "ledger": {
            "Address": "http://ledger:8080"
          }
        }
      },
      "reconciliation-cluster": {
        "Destinations": {
          "reconciliation": {
            "Address": "http://reconciliation:8080"
          }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment": {
            "Address": "http://payment:8080"
          }
        }
      }
    }
  }
}
